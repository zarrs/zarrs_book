vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    # theme-id: 300
    pad: 10
  }
}

*.style.font-size: 32
*.**.style.font-size: 32

style: {
  fill: transparent
}

classes: {
  grayDashed {
    style: {
      stroke-dash: 5
    }
  }
  community {
    style: {
      fill: "#c2410c"
      stroke: "#7c2d12"
      font-color: "#ffffff"
    }
  }
}

direction: up

tools: CLI Tools {
  zarrs_tools {
    link: https://github.com/zarrs/zarrs_tools
    tooltip: |md
      Various tools for creating and manipulating Zarr V3 data with the zarrs rust crate
        - A reencoder that can change codecs, chunk shape, convert Zarr V2 to V3, etc.
        - Create an OME-Zarr hierarchy from a Zarr array.
        - Transform arrays: crop, rescale, downsample, gradient magnitude, gaussian, noise filtering, etc.
    |
  }
}

metadata_conventions: Metadata Conventions {
  grid-columns: 1
  ome_zarr_metadata {
    link: https://github.com/zarrs/ome_zarr_metadata
    tooltip: A library for OME-Zarr (previously OME-NGFF) metadata.
  }
  zarrs_conventions: zarrs_conventions\n_license / _thumbnails / _uom {
    class: community
    link: https://github.com/clbarnes/zarrs_conventions
    tooltip: An implementation of the `zarr-conventions` specification, with crates for the license, thumbnails, and units of measure conventions (community).
  }
}

extension_impls: Extension Implementations {
  grid-columns: 1
  direction: right
  zarrs_jpeg {
    class: community
    link: https://github.com/clbarnes/zarrs_jpeg
    tooltip: The proposed `jpeg` codec, backed by libjpeg-turbo (community, unpublished).
  }
  ndic_zarr: ndic-zarr {
    class: community
    link: https://github.com/fideus-labs/nd-image-codecs
    tooltip: The `nd_lift`, `htj2k`, and `nd_zfp` codecs for multidimensional scientific images (community).
  }
}

stores: Stores and Storage Adapters {
  direction: right
  grid-columns: 2
  zarrs_filesystem: zarrs_filesystem\nzarrs::filesystem {
    link: https://github.com/zarrs/zarrs/tree/main/zarrs_filesystem
    tooltip: A filesystem store (re-exported as `zarrs::filesystem`).
  }
  zarrs_object_store {
    link: https://github.com/zarrs/zarrs_object_store
    tooltip: `object_store` store support.
  }
  zarrs_opendal {
    link: https://github.com/zarrs/zarrs_opendal
    tooltip: `opendal` store support.
  }
  zarrs_http {
    link: https://github.com/zarrs/zarrs_http
    tooltip: A synchronous http store.
  }
  zarrs_icechunk {
    link: https://github.com/zarrs/zarrs_icechunk
    tooltip: |md
      `icechunk` store support.
        - git-like version control for Zarr hierachies.
        - Read "virtual Zarr datacubes" of archival formats (e.g., netCDF4, HDF5, etc.) created by `VirtualiZarr` and backed by `icechunk`.
    |
  }
  zarrs_zip {
    link: https://github.com/zarrs/zarrs_zip
    tooltip: A storage adapter for zip files.
  }
  zarrs_sqlite {
    class: community
    link: https://github.com/clbarnes/zarrs_sqlite
    tooltip: An SQLite-based Zarr store (community, unpublished).
  }
  zarrs_n5 {
    class: community
    link: https://github.com/clbarnes/zarrs_n5
    tooltip: Read-only N5 support (community).
  }
}

core: Core / Extension APIs {
  zarrs_storage: zarrs_storage\nzarrs::storage {
    link: https://github.com/zarrs/zarrs/tree/main/zarrs_storage
    tooltip: The storage API for `zarrs` (re-exported as `zarrs::storage`).
  }
  zarrs_metadata_ext: zarrs_metadata_ext\nzarrs::metadata_ext {
    link: https://github.com/zarrs/zarrs/tree/main/zarrs_metadata_ext
    tooltip: Zarr extensions metadata support.
  }
  zarrs_metadata: zarrs_metadata\nzarrs::metadata {
    link: https://github.com/zarrs/zarrs/tree/main/zarrs_metadata
    tooltip: Zarr metadata support (re-exported as `zarrs::metadata`).
  }
  zarrs_plugin: zarrs_plugin\nzarrs::plugin {
    link: https://github.com/zarrs/zarrs/tree/main/zarrs_plugin
    tooltip: The plugin API for `zarrs` (re-exported as `zarrs::plugin`).
  }

  extensions: Zarr Extension Points\n(zarrs::array::*::api) {
    direction: right
    grid-columns: 1
    zarrs_data_type: {
        link: https://github.com/zarrs/zarrs/tree/main/zarrs_data_type
        tooltip: The data type extension API for `zarrs` (re-exported as `zarrs::array::data_type::api`).
    }
    zarrs_codec: {
        link: https://github.com/zarrs/zarrs/tree/main/zarrs_codec
        tooltip: The codec extension API for `zarrs` (re-exported as `zarrs::array::codec::api`).
    }
    zarrs_chunk_grid: {
        link: https://github.com/zarrs/zarrs/tree/main/zarrs_chunk_grid
        tooltip: The chunk grid extension API for `zarrs` (re-exported as `zarrs::array::chunk_grid::api`).
    }
    zarrs_chunk_key_encoding: {
        link: https://github.com/zarrs/zarrs/tree/main/zarrs_chunk_key_encoding
        tooltip: The chunk key encoding extension API for `zarrs` (re-exported as `zarrs::array::chunk_key_encoding::api`).
    }
  }
  zarrs {
    link: https://github.com/zarrs/zarrs/tree/main/zarrs
    tooltip: The core library for manipulating Zarr hierarchies.
  }
}

Bindings: {
  grid-columns: 2
  zarrs_ffi: zarrs_ffi (C/C++) {
    link: https://github.com/zarrs/zarrs_ffi
    tooltip: A subset of `zarrs` exposed as a C/C++ API.
  }
  zarrs_python: zarrs-python (Python)\nzarr-python codec pipeline {
    link: https://github.com/zarrs/zarrs-python
    tooltip: A high-performance codec pipeline for `zarr-developers/zarr-python`.
  }
  zarrista: zarrista (Python) {
    class: community
    link: https://github.com/developmentseed/zarrista
    tooltip: A low-level Zarr API for Python built directly on `zarrs` (community).
  }
  zarr_matlab: zarr-matlab (MATLAB) {
    class: community
    link: https://github.com/scalableminds/zarr-matlab
    tooltip: A Zarr V2/V3 implementation for MATLAB based on `zarrs` (community).
  }
  pizzarr: pizzarr (R) {
    class: community
    link: https://github.com/zarr-developers/pizzarr
    tooltip: A Zarr implementation for R with an optional `zarrs` backend (community).
  }
  Rzarrs: Rzarrs (R) {
    class: community
    link: https://github.com/RGenomicsETL/Rzarrs
    tooltip: Read-only R bindings to `zarrs` (community).
  }
  Zarrs_jl: Zarrs.jl (Julia) {
    class: community
    link: https://github.com/earth-mover/Zarrs.jl
    tooltip: Zarr V2/V3 arrays for Julia backed by `zarrs` (community).
  }
}

core.zarrs_storage -> core.zarrs
core.zarrs_metadata_ext -> core.zarrs
core.zarrs_metadata -> core.zarrs_metadata_ext
core.zarrs_metadata_ext -> core.extensions
core.zarrs_plugin -> core.extensions
core.extensions -> core.zarrs
metadata_conventions -> tools
core -> tools
core -> Bindings

# Implementations are ranked below the core APIs, but the arrowheads point from
# the API to its implementations. `<->` with the target arrowhead removed gives
# the desired arrow direction without flipping the layout rank.
stores <-> core.zarrs_storage: { target-arrowhead.shape: none }
extension_impls <-> core.extensions: { target-arrowhead.shape: none }

legend: Legend {
  near: top-center
  grid-columns: 2
  grid-gap: 10
  style.stroke-dash: 4
  # d2 grids fill column-major, so both swatches are declared before both labels
  # in order to pair them up by row.
  sw_first: "" {
    width: 56
    height: 30
  }
  sw_community: "" {
    class: community
    width: 56
    height: 30
  }
  txt_first: zarrs (first party) {
    shape: text
  }
  txt_community: community (third party) {
    shape: text
  }
}
